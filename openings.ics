---
layout: null
permalink: /openings.ics
sitemap: false
---
{% assign s = site.data.settings %}BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//{{ s.name }}//Website//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:{{ s.name }} · Openings
BEGIN:VTIMEZONE
TZID:Europe/Zurich
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
{% for e in site.exhibitions %}{% if e.opening_time and e.opening_time != '' %}BEGIN:VEVENT
UID:{{ e.slug }}-opening@{{ site.url | remove: 'https://' | remove: 'http://' }}
DTSTAMP:{{ site.time | date: '%Y%m%dT%H%M%S' }}Z
DTSTART;TZID=Europe/Zurich:{{ e.start | date: '%Y%m%d' }}T{{ e.opening_time | remove: ':' }}00
SUMMARY:{{ e.title }} · Opening{% if e.with %} ({{ e.with }}){% endif %}
LOCATION:{{ e.venue | replace: ',', '\,' }}\, {{ e.address | replace: ',', '\,' }}
DESCRIPTION:{{ e.kind }}. {{ e.dates | replace: ',', '\,' }}.
URL:{{ '/exhibitions/' | absolute_url }}#{{ e.slug }}
END:VEVENT
{% endif %}{% endfor %}END:VCALENDAR
